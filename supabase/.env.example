# Only for running the seed script on your own computer. This file must never be
# committed and these values must never go into the mobile app or the admin page.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Project Settings -> API -> secret key (older projects: service_role key).
SUPABASE_SECRET_KEY=your-secret-key
# Password given to the demo admin and company logins. Pick your own, 10+ characters.
SEED_PASSWORD=
# Project Settings -> API -> publishable key. Used by "npm run demo", which signs in as
# the demo users rather than using the secret key.
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
