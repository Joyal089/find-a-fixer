# Copy to .env (local) and add the same two values in Vercel -> Project -> Environment Variables.
# Use the publishable/anon key only. Admin rights come from the signed-in user's role,
# checked by the database - never from a secret key in this page.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_KEY=your-publishable-or-anon-key
